# RevenueCat (public SDK keys from dashboard → Apps)
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# AdMob unit IDs (app IDs live in app.json plugin)
# iOS app: ca-app-pub-3859855802547804~5410835231
# Android app: ca-app-pub-3859855802547804~6624257573
# Defaults: Google test units in __DEV__; production units in release when USE_TEST_IDS=0
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=
# Rewarded interstitial (ads-off break)
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=ca-app-pub-3859855802547804/2171649565
# Comma-separated GAD test device IDs from Xcode console (physical phones)
# EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=
# Set to 0 in production builds once real iOS units are wired
# EXPO_PUBLIC_ADMOB_USE_TEST_IDS=0
