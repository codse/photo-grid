{
  "expo": {
    "name": "Passport Photo Print",
    "owner": "codse",
    "slug": "passport-photo-print",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "passportphotoprint",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFCF9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codse.passport.photo.print",
      "appleTeamId": "53WLLK8L87",
      "appStoreUrl": "https://apps.apple.com/app/id6798807833",
      "infoPlist": {
        "NSCameraUsageDescription": "Passport Photo Print needs the camera to take passport and ID photos.",
        "NSPhotoLibraryUsageDescription": "Passport Photo Print needs photo library access to import and save ID photos.",
        "NSPhotoLibraryAddUsageDescription": "Passport Photo Print saves printable photo sheets to your library.",
        "NSLocationWhenInUseUsageDescription": "Location may be used by advertising partners to show more relevant ads. Passport Photo Print does not use your location for passport or ID photo features.",
        "ITSAppUsesNonExemptEncryption": false,
        "GADApplicationIdentifier": "ca-app-pub-3859855802547804~5410835231",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "package": "com.codse.passport.photo.print",
      "adaptiveIcon": {
        "backgroundColor": "#FFFCF9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-ios-scene-delegate.js",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Passport Photo Print to access your photos for passport and ID sheets.",
          "cameraPermission": "Allow Passport Photo Print to use the camera for passport and ID photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Passport Photo Print to save printable sheets to your photos.",
          "savePhotosPermission": "Allow Passport Photo Print to save printable sheets to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Passport Photo Print needs the camera to take passport and ID photos.",
          "enableMicrophonePermission": false
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-splash-screen",
      [
        "react-native-google-mobile-ads",
